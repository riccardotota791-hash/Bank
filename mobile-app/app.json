{
  "expo": {
    "name": "Risparmio Buffett",
    "slug": "risparmio-buffett",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "risparmiobuffett",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#246AAD"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d3d40b65-85cb-4451-9fda-a7e3a1a69b98"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.riccardotota.risparmiobuffett"
    },
    "android": {
      "package": "com.riccardotota.risparmiobuffett",
      "adaptiveIcon": {
        "backgroundColor": "#246AAD",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1F6F50"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d3d40b65-85cb-4451-9fda-a7e3a1a69b98"
      }
    },
    "owner": "riol05x"
  }
}
