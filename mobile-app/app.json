{
  "expo": {
    "name": "Risparmio Buffett",
    "slug": "risparmio-buffett",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "risparmiobuffett",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#246AAD"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.riccardotota.risparmiobuffett"
    },
    "android": {
      "package": "com.riccardotota.risparmiobuffett",
      "adaptiveIcon": {
        "backgroundColor": "#246AAD",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "permissions": ["RECEIVE_BOOT_COMPLETED", "SCHEDULE_EXACT_ALARM"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1F6F50"
        }
      ]
    ],
    "extra": {
      "eas": {}
    }
  }
}
